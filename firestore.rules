rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Hardened Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'rituparno.tnts@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidSlug(slug) {
      return slug is string && slug.size() >= 2 && slug.size() <= 100 && slug.matches('^[a-z0-9\\-]+$');
    }

    function isValidImageString(val) {
      return val is string && val.size() >= 1 && val.size() <= 900000;
    }

    function isValidOptionalImageString(val) {
      return val is string && val.size() <= 900000;
    }

    function isValidHeroBanners(banners) {
      return banners is list && banners.size() <= 6 && (banners.size() == 0 || banners[0] is string);
    }

    function isValidGalleryImages(images) {
      return images is list && images.size() <= 8 && (images.size() == 0 || images[0] is string);
    }

    function isValidNavLinks(links) {
      return links is list && links.size() <= 15 && (links.size() == 0 || links[0] is map);
    }

    function isValidHomepageSections(sections) {
      return sections is list && sections.size() <= 20 && (sections.size() == 0 || sections[0] is map);
    }

    function isValidFeatureList(features) {
      return features is list && features.size() <= 10 && (features.size() == 0 || features[0] is string);
    }

    function isValidPageSections(sections) {
      return sections is list && sections.size() <= 20 && (sections.size() == 0 || sections[0] is map);
    }

    // 3. Entity Validation Blueprints
    function isValidSiteSettings(data) {
      return data.keys().hasAll([
          'brandName', 'heroHeadline', 'heroSubheadline', 'heroBanners',
          'aboutHeading', 'aboutStory', 'contactEmail', 'seoTitle', 'seoDescription', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'brandName', 'logoUrl', 'faviconUrl', 'primaryColor', 'secondaryColor',
          'fontPreset', 'loadingScreenEnabled', 'loadingScreenText', 'maintenanceMode',
          'maintenanceMessage', 'footerTagline', 'copyrightText', 'headerCtaText', 'headerCtaLink',
          'customHeadScript', 'navLinks', 'homepageSections',
          'heroHeadline', 'heroSubheadline', 'heroPrimaryCtaText', 'heroPrimaryCtaLink',
          'heroSecondaryCtaText', 'heroSecondaryCtaLink', 'heroBanners',
          'aboutEyebrow', 'aboutHeading', 'aboutStory', 'aboutPhilosophy', 'aboutImageUrl',
          'photographerNames', 'photographerBio',
          'contactHeading', 'contactDescription', 'contactEmail', 'contactPhone', 'whatsappNumber',
          'studioAddress', 'googleMapsUrl', 'instagramUrl', 'facebookUrl', 'youtubeUrl',
          'behanceUrl', 'pinterestUrl',
          'seoTitle', 'seoDescription', 'seoKeywords', 'seoOgTitle', 'seoOgDescription',
          'seoOgImage', 'seoCanonicalUrl', 'seoNoIndex', 'updatedAt'
        ]) &&
        data.brandName is string && data.brandName.size() >= 1 && data.brandName.size() <= 80 &&
        (!('logoUrl' in data) || isValidOptionalImageString(data.logoUrl)) &&
        (!('faviconUrl' in data) || isValidOptionalImageString(data.faviconUrl)) &&
        (!('primaryColor' in data) || (data.primaryColor is string && data.primaryColor.size() <= 20)) &&
        (!('secondaryColor' in data) || (data.secondaryColor is string && data.secondaryColor.size() <= 20)) &&
        (!('fontPreset' in data) || (data.fontPreset is string && data.fontPreset.size() <= 40)) &&
        (!('loadingScreenEnabled' in data) || data.loadingScreenEnabled is bool) &&
        (!('loadingScreenText' in data) || (data.loadingScreenText is string && data.loadingScreenText.size() <= 120)) &&
        (!('maintenanceMode' in data) || data.maintenanceMode is bool) &&
        (!('maintenanceMessage' in data) || (data.maintenanceMessage is string && data.maintenanceMessage.size() <= 500)) &&
        (!('footerTagline' in data) || (data.footerTagline is string && data.footerTagline.size() <= 240)) &&
        (!('copyrightText' in data) || (data.copyrightText is string && data.copyrightText.size() <= 200)) &&
        (!('headerCtaText' in data) || (data.headerCtaText is string && data.headerCtaText.size() <= 60)) &&
        (!('headerCtaLink' in data) || (data.headerCtaLink is string && data.headerCtaLink.size() <= 160)) &&
        (!('customHeadScript' in data) || (data.customHeadScript is string && data.customHeadScript.size() <= 2000)) &&
        (!('navLinks' in data) || isValidNavLinks(data.navLinks)) &&
        (!('homepageSections' in data) || isValidHomepageSections(data.homepageSections)) &&
        data.heroHeadline is string && data.heroHeadline.size() >= 3 && data.heroHeadline.size() <= 160 &&
        data.heroSubheadline is string && data.heroSubheadline.size() >= 3 && data.heroSubheadline.size() <= 280 &&
        (!('heroPrimaryCtaText' in data) || (data.heroPrimaryCtaText is string && data.heroPrimaryCtaText.size() <= 60)) &&
        (!('heroPrimaryCtaLink' in data) || (data.heroPrimaryCtaLink is string && data.heroPrimaryCtaLink.size() <= 160)) &&
        (!('heroSecondaryCtaText' in data) || (data.heroSecondaryCtaText is string && data.heroSecondaryCtaText.size() <= 60)) &&
        (!('heroSecondaryCtaLink' in data) || (data.heroSecondaryCtaLink is string && data.heroSecondaryCtaLink.size() <= 160)) &&
        isValidHeroBanners(data.heroBanners) &&
        (!('aboutEyebrow' in data) || (data.aboutEyebrow is string && data.aboutEyebrow.size() <= 80)) &&
        data.aboutHeading is string && data.aboutHeading.size() >= 2 && data.aboutHeading.size() <= 160 &&
        data.aboutStory is string && data.aboutStory.size() >= 10 && data.aboutStory.size() <= 3000 &&
        (!('aboutPhilosophy' in data) || (data.aboutPhilosophy is string && data.aboutPhilosophy.size() <= 2000)) &&
        (!('aboutImageUrl' in data) || isValidOptionalImageString(data.aboutImageUrl)) &&
        (!('photographerNames' in data) || (data.photographerNames is string && data.photographerNames.size() <= 120)) &&
        (!('photographerBio' in data) || (data.photographerBio is string && data.photographerBio.size() <= 1500)) &&
        (!('contactHeading' in data) || (data.contactHeading is string && data.contactHeading.size() <= 160)) &&
        (!('contactDescription' in data) || (data.contactDescription is string && data.contactDescription.size() <= 600)) &&
        data.contactEmail is string && data.contactEmail.size() >= 5 && data.contactEmail.size() <= 160 &&
        (!('contactPhone' in data) || (data.contactPhone is string && data.contactPhone.size() <= 60)) &&
        (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 60)) &&
        (!('studioAddress' in data) || (data.studioAddress is string && data.studioAddress.size() <= 240)) &&
        (!('googleMapsUrl' in data) || (data.googleMapsUrl is string && data.googleMapsUrl.size() <= 400)) &&
        (!('instagramUrl' in data) || (data.instagramUrl is string && data.instagramUrl.size() <= 300)) &&
        (!('facebookUrl' in data) || (data.facebookUrl is string && data.facebookUrl.size() <= 300)) &&
        (!('youtubeUrl' in data) || (data.youtubeUrl is string && data.youtubeUrl.size() <= 300)) &&
        (!('behanceUrl' in data) || (data.behanceUrl is string && data.behanceUrl.size() <= 300)) &&
        (!('pinterestUrl' in data) || (data.pinterestUrl is string && data.pinterestUrl.size() <= 300)) &&
        data.seoTitle is string && data.seoTitle.size() >= 3 && data.seoTitle.size() <= 120 &&
        data.seoDescription is string && data.seoDescription.size() >= 10 && data.seoDescription.size() <= 320 &&
        (!('seoKeywords' in data) || (data.seoKeywords is string && data.seoKeywords.size() <= 300)) &&
        (!('seoOgTitle' in data) || (data.seoOgTitle is string && data.seoOgTitle.size() <= 120)) &&
        (!('seoOgDescription' in data) || (data.seoOgDescription is string && data.seoOgDescription.size() <= 320)) &&
        (!('seoOgImage' in data) || isValidOptionalImageString(data.seoOgImage)) &&
        (!('seoCanonicalUrl' in data) || (data.seoCanonicalUrl is string && data.seoCanonicalUrl.size() <= 300)) &&
        (!('seoNoIndex' in data) || data.seoNoIndex is bool) &&
        data.updatedAt == request.time;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'slug', 'order', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'slug', 'description', 'order', 'createdAt', 'updatedAt']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        isValidSlug(data.slug) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 300)) &&
        data.order is number && data.order >= 0 && data.order <= 1000 &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidAlbum(data) {
      return data.keys().hasAll(['title', 'slug', 'published', 'order', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['title', 'slug', 'description', 'coverImageUrl', 'categoryId', 'published', 'order', 'createdAt', 'updatedAt']) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        isValidSlug(data.slug) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        (!('coverImageUrl' in data) || isValidOptionalImageString(data.coverImageUrl)) &&
        (!('categoryId' in data) || (data.categoryId is string && data.categoryId.size() <= 128)) &&
        data.published is bool &&
        data.order is number && data.order >= 0 && data.order <= 1000 &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidPortfolioItem(data) {
      return data.keys().hasAll([
          'title', 'categoryId', 'categoryName', 'imageUrl',
          'aspectRatio', 'featured', 'order', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'description', 'altText', 'categoryId', 'categoryName', 'albumId', 'imageUrl',
          'aspectRatio', 'location', 'cameraSpecs', 'year',
          'featured', 'published', 'order', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        (!('altText' in data) || (data.altText is string && data.altText.size() <= 200)) &&
        isValidId(data.categoryId) &&
        data.categoryName is string && data.categoryName.size() >= 2 && data.categoryName.size() <= 80 &&
        (!('albumId' in data) || (data.albumId is string && data.albumId.size() <= 128)) &&
        isValidImageString(data.imageUrl) &&
        data.aspectRatio in ['portrait', 'landscape', 'square'] &&
        (!('location' in data) || (data.location is string && data.location.size() <= 120)) &&
        (!('cameraSpecs' in data) || (data.cameraSpecs is string && data.cameraSpecs.size() <= 120)) &&
        (!('year' in data) || (data.year is string && data.year.size() <= 10)) &&
        data.featured is bool &&
        (!('published' in data) || data.published is bool) &&
        data.order is number && data.order >= 0 && data.order <= 10000 &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidProject(data) {
      return data.keys().hasAll([
          'title', 'slug', 'categoryName', 'location',
          'summary', 'coverImageUrl', 'galleryImages', 'order', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'slug', 'categoryName', 'location', 'dateLabel', 'clientName',
          'summary', 'editorialNotes', 'coverImageUrl', 'galleryImages',
          'published', 'order', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
        isValidSlug(data.slug) &&
        data.categoryName is string && data.categoryName.size() >= 2 && data.categoryName.size() <= 80 &&
        data.location is string && data.location.size() >= 2 && data.location.size() <= 120 &&
        (!('dateLabel' in data) || (data.dateLabel is string && data.dateLabel.size() <= 60)) &&
        (!('clientName' in data) || (data.clientName is string && data.clientName.size() <= 120)) &&
        data.summary is string && data.summary.size() >= 10 && data.summary.size() <= 600 &&
        (!('editorialNotes' in data) || (data.editorialNotes is string && data.editorialNotes.size() <= 3000)) &&
        isValidImageString(data.coverImageUrl) &&
        isValidGalleryImages(data.galleryImages) &&
        (!('published' in data) || data.published is bool) &&
        data.order is number && data.order >= 0 && data.order <= 1000 &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidService(data) {
      return data.keys().hasAll(['title', 'slug', 'description', 'order', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'title', 'slug', 'description', 'deliverables', 'startingPrice',
          'imageUrl', 'iconName', 'features', 'enabled', 'order', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        isValidSlug(data.slug) &&
        data.description is string && data.description.size() >= 10 && data.description.size() <= 600 &&
        (!('deliverables' in data) || (data.deliverables is string && data.deliverables.size() <= 240)) &&
        (!('startingPrice' in data) || (data.startingPrice is string && data.startingPrice.size() <= 60)) &&
        (!('imageUrl' in data) || isValidOptionalImageString(data.imageUrl)) &&
        (!('iconName' in data) || (data.iconName is string && data.iconName.size() <= 40)) &&
        (!('features' in data) || isValidFeatureList(data.features)) &&
        (!('enabled' in data) || data.enabled is bool) &&
        data.order is number && data.order >= 0 && data.order <= 1000 &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidTestimonial(data) {
      return data.keys().hasAll(['clientName', 'clientRole', 'quote', 'rating', 'order', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['clientName', 'clientRole', 'quote', 'rating', 'avatarUrl', 'featured', 'published', 'order', 'createdAt', 'updatedAt']) &&
        data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 100 &&
        data.clientRole is string && data.clientRole.size() >= 2 && data.clientRole.size() <= 120 &&
        data.quote is string && data.quote.size() >= 10 && data.quote.size() <= 1000 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        (!('avatarUrl' in data) || isValidOptionalImageString(data.avatarUrl)) &&
        (!('featured' in data) || data.featured is bool) &&
        (!('published' in data) || data.published is bool) &&
        data.order is number && data.order >= 0 && data.order <= 1000 &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidPage(data) {
      return data.keys().hasAll(['title', 'slug', 'status', 'sections', 'order', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'title', 'slug', 'status', 'sections', 'seoTitle', 'seoDescription',
          'seoKeywords', 'ogTitle', 'ogDescription', 'ogImage', 'canonicalUrl', 'noIndex',
          'order', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
        isValidSlug(data.slug) &&
        data.status in ['draft', 'published'] &&
        isValidPageSections(data.sections) &&
        (!('seoTitle' in data) || (data.seoTitle is string && data.seoTitle.size() <= 120)) &&
        (!('seoDescription' in data) || (data.seoDescription is string && data.seoDescription.size() <= 320)) &&
        (!('seoKeywords' in data) || (data.seoKeywords is string && data.seoKeywords.size() <= 300)) &&
        (!('ogTitle' in data) || (data.ogTitle is string && data.ogTitle.size() <= 120)) &&
        (!('ogDescription' in data) || (data.ogDescription is string && data.ogDescription.size() <= 320)) &&
        (!('ogImage' in data) || isValidOptionalImageString(data.ogImage)) &&
        (!('canonicalUrl' in data) || (data.canonicalUrl is string && data.canonicalUrl.size() <= 300)) &&
        (!('noIndex' in data) || data.noIndex is bool) &&
        data.order is number && data.order >= 0 && data.order <= 1000 &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidMediaAsset(data) {
      return data.keys().hasAll(['name', 'url', 'mediaType', 'folder', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'url', 'mediaType', 'folder', 'altText', 'width', 'height', 'sizeBytes', 'createdAt', 'updatedAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 140 &&
        isValidImageString(data.url) &&
        data.mediaType in ['image', 'video'] &&
        data.folder is string && data.folder.size() >= 1 && data.folder.size() <= 60 &&
        (!('altText' in data) || (data.altText is string && data.altText.size() <= 200)) &&
        (!('width' in data) || (data.width is number && data.width >= 0)) &&
        (!('height' in data) || (data.height is number && data.height >= 0)) &&
        (!('sizeBytes' in data) || (data.sizeBytes is number && data.sizeBytes >= 0)) &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll([
          'name', 'email', 'phone', 'eventDate', 'serviceName',
          'location', 'message', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name', 'email', 'phone', 'eventDate', 'serviceName',
          'location', 'message', 'status', 'adminNotes', 'createdAt', 'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 160 &&
        data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 40 &&
        data.eventDate is string && data.eventDate.size() >= 4 && data.eventDate.size() <= 40 &&
        data.serviceName is string && data.serviceName.size() >= 2 && data.serviceName.size() <= 120 &&
        data.location is string && data.location.size() >= 2 && data.location.size() <= 160 &&
        data.message is string && data.message.size() >= 5 && data.message.size() <= 2000 &&
        data.status in ['new', 'contacted', 'confirmed', 'completed', 'reviewed', 'booked', 'archived'] &&
        (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 1000)) &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'createdAt']) &&
        data.keys().hasOnly(['email', 'displayName', 'role', 'addedBy', 'createdAt']) &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 160 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('role' in data) || data.role in ['super_admin', 'editor', 'moderator']) &&
        (!('addedBy' in data) || (data.addedBy is string && data.addedBy.size() <= 128)) &&
        data.createdAt is timestamp;
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll(['actorEmail', 'action', 'target', 'createdAt']) &&
        data.keys().hasOnly(['actorEmail', 'action', 'target', 'createdAt']) &&
        data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 160 &&
        data.action is string && data.action.size() >= 2 && data.action.size() <= 140 &&
        data.target is string && data.target.size() >= 1 && data.target.size() <= 140 &&
        data.createdAt == request.time;
    }

    // 4. Collection Rules
    match /siteSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(settingId) && isValidSiteSettings(incoming());
      allow update: if isAdmin() && isValidId(settingId) && isValidSiteSettings(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'brandName', 'logoUrl', 'faviconUrl', 'primaryColor', 'secondaryColor',
          'fontPreset', 'loadingScreenEnabled', 'loadingScreenText', 'maintenanceMode',
          'maintenanceMessage', 'footerTagline', 'copyrightText', 'headerCtaText', 'headerCtaLink',
          'customHeadScript', 'navLinks', 'homepageSections',
          'heroHeadline', 'heroSubheadline', 'heroPrimaryCtaText', 'heroPrimaryCtaLink',
          'heroSecondaryCtaText', 'heroSecondaryCtaLink', 'heroBanners',
          'aboutEyebrow', 'aboutHeading', 'aboutStory', 'aboutPhilosophy', 'aboutImageUrl',
          'photographerNames', 'photographerBio',
          'contactHeading', 'contactDescription', 'contactEmail', 'contactPhone', 'whatsappNumber',
          'studioAddress', 'googleMapsUrl', 'instagramUrl', 'facebookUrl', 'youtubeUrl',
          'behanceUrl', 'pinterestUrl',
          'seoTitle', 'seoDescription', 'seoKeywords', 'seoOgTitle', 'seoOgDescription',
          'seoOgImage', 'seoCanonicalUrl', 'seoNoIndex', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(settingId);
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'description', 'order', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    match /albums/{albumId} {
      allow get: if isValidId(albumId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(albumId) && isValidAlbum(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(albumId) && isValidAlbum(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'slug', 'description', 'coverImageUrl', 'categoryId', 'published', 'order', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(albumId);
    }

    match /portfolioItems/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(itemId) && isValidPortfolioItem(incoming()) &&
        incoming().createdAt == request.time &&
        (exists(/databases/$(database)/documents/categories/$(incoming().categoryId)) ||
         existsAfter(/databases/$(database)/documents/categories/$(incoming().categoryId)));
      allow update: if isAdmin() && isValidId(itemId) && isValidPortfolioItem(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        (exists(/databases/$(database)/documents/categories/$(incoming().categoryId)) ||
         existsAfter(/databases/$(database)/documents/categories/$(incoming().categoryId))) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'description', 'altText', 'categoryId', 'categoryName', 'albumId', 'imageUrl',
          'aspectRatio', 'location', 'cameraSpecs', 'year',
          'featured', 'published', 'order', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(itemId);
    }

    match /projects/{projectId} {
      allow get: if isValidId(projectId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(projectId) && isValidProject(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(projectId) && isValidProject(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'slug', 'categoryName', 'location', 'dateLabel', 'clientName',
          'summary', 'editorialNotes', 'coverImageUrl', 'galleryImages', 'published', 'order', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(projectId);
    }

    match /services/{serviceId} {
      allow get: if isValidId(serviceId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(serviceId) && isValidService(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(serviceId) && isValidService(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'slug', 'description', 'deliverables', 'startingPrice',
          'imageUrl', 'iconName', 'features', 'enabled', 'order', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(serviceId);
    }

    match /testimonials/{testimonialId} {
      allow get: if isValidId(testimonialId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(testimonialId) && isValidTestimonial(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(testimonialId) && isValidTestimonial(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'clientName', 'clientRole', 'quote', 'rating', 'avatarUrl', 'featured', 'published', 'order', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(testimonialId);
    }

    match /pages/{pageId} {
      allow get: if isValidId(pageId) && (existing().status == 'published' || isAdmin());
      allow list: if resource.data.status == 'published' || isAdmin();
      allow create: if isAdmin() && isValidId(pageId) && isValidPage(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(pageId) && isValidPage(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'slug', 'status', 'sections', 'seoTitle', 'seoDescription',
          'seoKeywords', 'ogTitle', 'ogDescription', 'ogImage', 'canonicalUrl', 'noIndex',
          'order', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(pageId);
    }

    match /mediaAssets/{assetId} {
      allow get: if isAdmin() && isValidId(assetId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(assetId) && isValidMediaAsset(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(assetId) && isValidMediaAsset(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'url', 'mediaType', 'folder', 'altText', 'width', 'height', 'sizeBytes', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(assetId);
    }

    match /inquiries/{inquiryId} {
      allow get: if isAdmin() && isValidId(inquiryId);
      allow list: if isAdmin();
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming()) &&
        incoming().status == 'new' &&
        !('adminNotes' in incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(inquiryId) && isValidInquiry(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNotes', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(inquiryId);
    }

    match /admins/{uid} {
      allow get: if isAdmin() && isValidId(uid);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(uid) && isValidAdminUser(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(uid) && isValidAdminUser(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'role']);
      allow delete: if isAdmin() && isValidId(uid);
    }

    match /activityLogs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(logId) && isValidActivityLog(incoming());
      allow update: if false;
      allow delete: if isAdmin() && isValidId(logId);
    }
  }
}
